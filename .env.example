# Server credentials. Copy to .env and fill in real values locally.
ORS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# PayFast uses sandbox by default. Set false only after production testing.
PAYFAST_SANDBOX=true
PORT=3000

# Optional URL overrides. Defaults use the production logmate.co.za domain.
APP_BASE_URL=https://logmate.co.za
# Leave the PayFast URL overrides empty so the server selects the correct
# production return page for subscriptions versus one-off exports.
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
PAYFAST_NOTIFY_URL=
